# ./lanpack setup generates real secrets in the ignored .env file.
LANPACK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
LANPACK_ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters
LANPACK_BIND_IP=127.0.0.1
LANPACK_PORT=8080
LANPACK_PUBLIC_URL=http://127.0.0.1:8080
LANPACK_EXPECTED_PLAYERS=27
