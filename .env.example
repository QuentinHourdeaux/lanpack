# ./lanpack setup generates a session secret in the ignored .env file.
# Initial password only; forced change on first login, then stored as a database hash.
LANPACK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
LANPACK_ADMIN_PASSWORD=admin
LANPACK_BIND_IP=127.0.0.1
LANPACK_PORT=8080
LANPACK_PUBLIC_URL=http://127.0.0.1:8080
LANPACK_EXPECTED_PLAYERS=25
